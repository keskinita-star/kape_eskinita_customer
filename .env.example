# Backend-only values. Never expose or commit these secrets.
PAYMONGO_SECRET_KEY=sk_test_replace_me
PAYMONGO_WEBHOOK_SECRET=replace_with_test_webhook_signing_secret

# Public Vercel deployment URL used for PayMongo redirects.
PUBLIC_SITE_URL=https://your-site.netlify.app

# Firebase Admin service-account credentials; server-side only.
